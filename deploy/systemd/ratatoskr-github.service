[Unit]
Description=Ratatoskr GitHub Catalog
After=network-online.target postgresql.service nats.service
Wants=network-online.target

[Service]
Type=exec
User=ratatoskr-github
Group=ratatoskr-github
EnvironmentFile=/etc/ratatoskr/github.env
LoadCredential=github.nkey:/etc/ratatoskr/github.nkey
LoadCredential=credential-key:/etc/ratatoskr/github-credential-key
ExecStart=/opt/ratatoskr/github/bin/ratatoskr-github-catalog
Restart=on-failure
RestartSec=5s
TimeoutStopSec=130s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/mnt/nvme/ratatoskr/log/github
StandardOutput=append:/mnt/nvme/ratatoskr/log/github/catalog.log
StandardError=append:/mnt/nvme/ratatoskr/log/github/catalog.log

[Install]
WantedBy=multi-user.target
